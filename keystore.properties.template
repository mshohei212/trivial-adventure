# Release signing credentials for TrivialAdventure.
#
# Copy this file to `keystore.properties` (same directory) and fill in real values.
# `keystore.properties` is gitignored -- never commit it, and never commit the keystore itself.
#
# If `keystore.properties` does not exist, `./gradlew :app:assembleRelease` still works; it
# just produces an UNSIGNED APK, which cannot be installed on a device or uploaded to Play.
#
# Generate a keystore with:
#
#   keytool -genkeypair -v \
#     -keystore keystore/trivialadventure-release.jks \
#     -alias trivialadventure -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=TrivialAdventure Sandbox, O=Google LLC, C=JP"

# Path to the keystore, relative to the repository root (absolute paths also work).
storeFile=keystore/trivialadventure-release.jks

# Password protecting the keystore file.
storePassword=CHANGE_ME

# Alias of the key inside the keystore (the -alias value used with keytool).
keyAlias=trivialadventure

# Password protecting that specific key. With -genkeypair it defaults to the store password.
keyPassword=CHANGE_ME
