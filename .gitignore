# Build output
# NOTE: `build/` (no leading slash) is required, not `/build` - the latter only matches the
# root directory and would let app/build/ (including the APK) be committed.
build/
.gradle/
.kotlin/
/captures
.externalNativeBuild
.cxx

# IDE / editor
*.iml
/.idea/
/.vscode/

# Machine-local: contains the absolute path to this machine's Android SDK.
local.properties

# macOS
.DS_Store

# The partner-distributed Trials SDK must not be committed.
/app/libs/*.aar

# Release signing material. Never commit these.
# Both rules matter: keystore.properties holds the passwords, and the extension globs catch a
# keystore dropped anywhere in the tree, not just the /keystore directory used by the README.
keystore.properties
*.jks
*.keystore
/keystore/

.agent
